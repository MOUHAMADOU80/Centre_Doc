<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="sn.ugb.centredoc.controller.admin.UfrController"
      spacing="16">
    <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Gestion des UFR" styleClass="page-titre" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="+ Ajouter une UFR" onAction="#onOuvrirFormulaireAjout" styleClass="bouton-principal"/>
    </HBox>

    <TableView fx:id="tableUfr" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colNom" text="Nom de l'UFR" prefWidth="280"/>
            <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="200"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="140"/>
        </columns>
    </TableView>

</VBox>