<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="racine" styleClass="app-shell" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="sn.ugb.centredoc.controller.etudiant.TelechargementController">
    <stylesheets><URL value="@../css/etudiant.css"/></stylesheets>

    <center>
        <VBox spacing="16" styleClass="contenu">
            <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

            <Label text="Téléchargement de document" styleClass="titre"/>
            <Label text="Choisissez le document que vous souhaitez télécharger" styleClass="sous-titre"/>

            <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colTitre" text="Document" prefWidth="320"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="colDate" text="Année" prefWidth="90"/>
                    <TableColumn fx:id="colAcces" text="Accès" prefWidth="150"/>
                    <TableColumn fx:id="colActions" text="Action" prefWidth="90"/>
                </columns>
                <placeholder><Label text="Aucun document disponible."/></placeholder>
            </TableView>

            <VBox styleClass="carte" spacing="6">
                <Label fx:id="labelEspace" styleClass="champ-nom"/>
                <ProgressBar fx:id="barreEspace" maxWidth="Infinity"/>
            </VBox>

            <Button text="← Retour" styleClass="lien" onAction="#onRetour"/>
        </VBox>
    </center>
</BorderPane>